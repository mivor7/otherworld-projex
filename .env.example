# Copy to .env for local development. Never commit a real .env.
# On Vercel these are set in Settings → Environment Variables. Vercel values
# are write-only: never `vercel env pull` and push the result back.

# ---- Required -------------------------------------------------------------

# Postgres. Pooled connection for the app, direct connection for migrations.
# The Neon/Vercel integration injects both in production. For local work use
# a separate database or Neon branch — the app has ONE production database.
DATABASE_URL="postgresql://user:password@localhost:5432/owp"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/owp"

# Signs session and arcade-run tokens. Required in production.
# Generate with: openssl rand -hex 32
SESSION_SECRET=""

# Solana mainnet RPC. Use a paid endpoint (Helius / Triton / QuickNode):
# the public ones refuse cloud IPs and indexed lookups. Set both to the same URL.
SOLANA_RPC_URL=""
NEXT_PUBLIC_SOLANA_RPC_URL=""

# The house wallet's PUBLIC key. One wallet is the admin, the treasury that
# receives deposits, and the payout signer — set all four to the same pubkey.
# The first ADMIN_WALLETS entry is the fallback for the other three.
ADMIN_WALLETS=""
TREASURY_WALLET=""
NEXT_PUBLIC_TREASURY_WALLET=""
PAYOUT_WALLET=""

# ---- Optional: token ------------------------------------------------------

# Only to override the published $OWP mint in src/lib/owp-mint.ts.
# OWP_MINT=""
# NEXT_PUBLIC_OWP_MINT=""
# Read from the mint account once it exists; this is the fallback.
# OWP_DECIMALS=6
# NEXT_PUBLIC_OWP_DECIMALS=6

# ---- Optional: economy defaults -------------------------------------------
# These are DEFAULTS. Every one can be changed live in /admin → House controls.

# HOUSE_EDGE=0.04                    # 0.005 – 0.15
# MIN_WAGER=1                        # whole $OWP
# MAX_WAGER=1000
# BOUNTY_POT_SHARE=0.5               # share of the edge that fills bounty pots
# BOUNTY_AUTO_PAY=false              # "true" lets bounties settle themselves
# BOUNTY_POOL_SHARE=0.3              # admin guidance for manual prizes only
# OWP_RANKED_MIN_BURNED=1000         # lifetime deposits to rank on prize boards
# OWP_RANKED_MIN_WINDOW_BURNED=100   # deposits inside the bounty window
# RANKED_MIN_TABLE_VOLUME=100        # wagered in-window to rank on a table board
# ARCADE_DAILY_SUBMISSIONS=40
# INVITE_REQUIRED=false              # "true" = new wallets need an invite code
# OWP_WAITLIST_MIN_HOLD=250000       # $OWP held on-chain to join the waitlist
# WAITLIST_GOAL=1000
# WAITLIST_OPEN=true

# ---- Optional: buying $OWP with SOL on the site ---------------------------

# Refuse website buys while the Raydium price is below this many SOL per
# 1,000,000 $OWP. 0 = no floor. See ONBOARDING.md before launch.
# OWP_MIN_SELL_PRICE=0
# A SOL payment handed in later than this many seconds after it confirmed is
# held for review in /admin instead of being priced automatically.
# OWP_BUY_MAX_PAYMENT_AGE_S=600
# Largest single buy, in whole $OWP (web server and payout worker).
# MAX_BUY_OWP=1000000000

# ---- Payout worker (scripts/payout-worker.mjs) ----------------------------
# Runs on its own box. NEVER set these on Vercel: the key is the treasury.

# The house wallet keypair as a JSON array. Or use a systemd credential named
# "payout-wallet", or PAYOUT_KEYPAIR_PATH pointing at a chmod-600 file.
# PAYOUT_WALLET_KEY=""
# PAYOUT_KEYPAIR_PATH=""
# MAX_PAYOUT_OWP=1000000             # bigger payouts wait for a human in /admin
# PAYOUT_INTERVAL_MS=15000
# "false" stops the house paying rent to open a recipient's missing $OWP
# account; those payouts wait until the recipient opens one.
# PAYOUT_CREATE_TOKEN_ACCOUNTS=true

# ---- Development only -----------------------------------------------------

# Free test balance on /games. Never set in production.
# DEV_FAUCET=true
# NEXT_PUBLIC_DEV_FAUCET=true

# Database tests (npm test). Must be a throwaway Postgres on localhost —
# the suite refuses anything else. Unset = database tests are skipped.
# TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5432/owp_test"
