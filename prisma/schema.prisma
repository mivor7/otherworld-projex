// Other World Projex — data model
// Postgres (Neon). DATABASE_URL is the pooled connection (runtime);
// DATABASE_URL_UNPOOLED is the direct connection Prisma needs for
// migrations. Both are auto-injected by the Neon/Vercel integration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String   @id @default(cuid())
  wallet        String   @unique // base58 Solana pubkey
  createdAt     DateTime @default(now())
  // Invite code this wallet joined with (invite-only launch); null = joined
  // while the gate was off, or pre-dates it.
  invitedVia    String?
  // Play credits earned by burning $RIBBIT (integer, smallest unit = 1 credit)
  credits       Int      @default(0)
  // Auction balance: $RIBBIT deposited to the treasury for bidding (raw token units)
  ribbitBalance BigInt   @default(0)
  // Portion of ribbitBalance currently locked in active bids
  ribbitLocked  BigInt   @default(0)
  isBanned      Boolean  @default(false)

  burns        BurnEvent[]
  rounds       GameRound[]
  bids         Bid[]
  deposits     Deposit[]
  withdrawals  Withdrawal[]
  applications ListingApplication[]
  scores       ArcadeScore[]
  seeds        ServerSeed[]
  ledger       LedgerEntry[]
  arcadeRuns   ArcadeRun[]
  bountyAwards BountyAward[]
  purchases    CreditPurchase[]
}

// A "buy credits" event: the player pays $RIBBIT in one signed tx that is
// split — part burned (deflation), part transferred to the treasury (real
// house revenue). Unlike a pure burn, this is what funds the reward pools.
// Unique signature prevents replay, same as BurnEvent.
model CreditPurchase {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  signature   String   @unique
  ribbitRaw   BigInt // total $RIBBIT paid (burned + house)
  burnedRaw   BigInt // portion destroyed
  houseRaw    BigInt // portion sent to treasury
  credits     Int
  createdAt   DateTime @default(now())
}

// Every credit movement is written to an append-only ledger for auditability.
model LedgerEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  delta     Int // credits, +/-
  kind      String // "burn" | "wager" | "payout" | "bounty" | "admin"
  ref       String? // tx signature, round id, bounty id...
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// A verified on-chain burn of $RIBBIT that granted play credits.
model BurnEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  signature String   @unique // tx signature — unique prevents replay
  amountRaw BigInt // raw token units burned
  credits   Int // credits granted
  createdAt DateTime @default(now())
}

// Provably-fair server seed (commit-reveal). Hash is shown before play;
// seed is revealed after rotation so players can verify every round.
model ServerSeed {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  seed       String // hex, secret until revealed
  seedHash   String // sha256(seed) hex, public immediately
  nonce      Int       @default(0) // increments per round
  active     Boolean   @default(true)
  revealedAt DateTime?
  createdAt  DateTime  @default(now())

  rounds GameRound[]

  @@index([userId, active])
}

model GameRound {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  seedId     String
  seed       ServerSeed @relation(fields: [seedId], references: [id])
  game       String // "flip" | "dice" | "blackjack"
  nonce      Int
  clientSeed String
  params     String // JSON: game-specific inputs (side, target...)
  outcome    String // JSON: result details / in-progress state
  wager      Int // credits
  payout     Int // credits (0 on loss)
  houseTake  Int // credits kept by house on this round (edge portion)
  // Multi-request games (blackjack) stay false until the round resolves.
  // Unsettled rounds block seed rotation so a revealed seed can never
  // expose cards still in play.
  settled    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, settled])
  @@index([game, createdAt])
}

// ------------------------- Auction house -------------------------

// $RIBBIT deposited to the treasury token account to fund bidding.
model Deposit {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  signature String   @unique
  amountRaw BigInt
  createdAt DateTime @default(now())
}

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  amountRaw   BigInt
  destination String // wallet pubkey
  status      String    @default("pending") // "pending" | "processing" | "sent" | "rejected"
  signature   String? // payout tx signature once sent
  // "balance" = user withdrawing their own escrow; "bounty" = a prize payout
  // funded by the treasury (no user-balance debit). Both flow through the
  // same off-server payout worker.
  kind        String    @default("balance")
  ref         String? // bounty id for bounty payouts
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

model Auction {
  id           String   @id @default(cuid())
  title        String
  description  String
  imageUrl     String?
  category     String   @default("collectible")
  sellerWallet String? // null = house listing
  // amounts in raw $RIBBIT units
  startBidRaw  BigInt
  minIncrement BigInt
  currentRaw   BigInt   @default(0)
  winnerUserId String?
  status       String   @default("live") // "live" | "settled" | "cancelled"
  // Physical/RWA lots need delivery tracking after they settle.
  fulfilled       Boolean @default(false)
  fulfillmentNote String?
  startsAt     DateTime @default(now())
  endsAt       DateTime
  createdAt    DateTime @default(now())

  bids Bid[]

  @@index([status, endsAt])
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amountRaw BigInt
  // "active" = current high bid (funds locked), "outbid" = released, "won"
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([auctionId, createdAt])
}

// Community members apply to list items in the auction house.
model ListingApplication {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String
  imageUrl    String?
  category    String   @default("collectible")
  askRaw      BigInt // suggested starting bid, raw $RIBBIT
  contact     String? // X handle / discord etc.
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  reviewNote  String?
  createdAt   DateTime @default(now())

  @@index([status, createdAt])
}

// ------------------------- Bounties & competitions -------------------------

model Bounty {
  id          String   @id @default(cuid())
  title       String
  description String
  // Narrative target of the contract, e.g. "The Highway Bandit"
  target      String?
  game        String? // linked game for leaderboard bounties ("hopper", "flip", "dice")
  kind        String   @default("leaderboard") // "leaderboard" | "challenge"
  prizeRibbit BigInt // prize pool in raw $RIBBIT units
  // House-contributed head start on the pot (raw $RIBBIT). The pot opens at
  // seed and play (the pot's share of the realized edge) funds prize − seed.
  // This is the house's DECLARED cost per fill; 0 = fully self-funded pot.
  seedRibbit  BigInt   @default(0)
  prizeText   String? // display override e.g. "5,000 $RIBBIT + badge"
  status      String   @default("open") // "open" | "closed" | "paid"
  paidAt      DateTime?
  // Auto-pay: when true, the bounty settles itself and pays every eligible
  // winner pro-rata (no manual admin award). Credit-game bounties trigger
  // when cumulative credits wagered on the game since startsAt reach
  // triggerCreditVolume; free-game bounties trigger at endsAt (weekly).
  autoPay            Boolean @default(false)
  triggerCreditVolume Int?   // credit-spend threshold (credit games only)
  // Owner's re-open switch: when true, a fresh round of this bounty opens
  // automatically after it settles (pot pays → new pot; weekly ends → new
  // week). Editable while the bounty is live — flip it off any time and the
  // current round becomes the last one.
  autoRenew   Boolean  @default(true)
  // Auto-numbered edition: 1 on creation, successor = parent + 1. Shown to
  // players so "which round am I in" is never a mystery.
  round       Int      @default(1)
  startsAt    DateTime @default(now())
  endsAt      DateTime
  createdAt   DateTime @default(now())

  awards      BountyAward[]

  @@index([status, endsAt])
}

// The pre-launch airdrop waitlist, imported from the final snapshot of the
// old signup site. A member's position and referral count are their EARNED
// place — preserve exactly as imported. Entry required holding 250k $RIBBIT
// at signup; the airdrop is guaranteed once the list reaches 1,000 people
// (amount to be announced by the owners). Import is idempotent by email
// (scripts/import-waitlist.mjs) — the newest snapshot always wins.
model WaitlistEntry {
  id          String   @id @default(cuid())
  position    Int
  displayName String
  // Imported members joined by email on the old signup site; members who join
  // on-site do it with a wallet and have no email. Exactly one of the two is
  // always present — both are unique so nobody can hold two places.
  email       String?  @unique
  // NOT unique: 11 imported wallets hold 13 duplicate places (multiple email
  // signups from one wallet on the old site) and those earned positions are
  // never rewritten. One place per wallet is enforced in the join path for
  // new sign-ups instead.
  wallet      String?
  joinedAt    DateTime
  referrals   Int      @default(0)
  // Who referred them: an imported code/name, or a referrer's wallet.
  referredBy  String?
  // On-chain $RIBBIT held at the moment of joining (raw units) — the proof
  // the holding requirement was met, kept for the record.
  heldRibbitRaw BigInt @default(0)
  importedAt  DateTime @default(now())

  @@index([position])
  @@index([wallet])
}

// One row per winner paid for a bounty. The prize is split across the top
// ranks; each award queues a treasury-funded Withdrawal (kind "bounty") that
// the off-server payout worker pays out — the same audited path as balance
// withdrawals. Records are immutable proof of who was paid what and why.
model BountyAward {
  id           String   @id @default(cuid())
  bountyId     String
  bounty       Bounty   @relation(fields: [bountyId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  rank         Int
  amountRaw    BigInt
  value        Int // the score / net-credits that won this rank (audit trail)
  withdrawalId String? // linked payout in the withdrawal queue
  createdAt    DateTime @default(now())

  @@index([bountyId])
}

// One row per issued arcade run token (id = the token's jti). Starting a new
// run voids any previous unused run for the same (user, game) — a wallet can
// only ever have one live seed per game, which kills seed-shopping: you
// can't request many tokens, simulate each seed offline, and play the
// luckiest one.
model ArcadeRun {
  id        String    @id // token jti
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  game      String
  createdAt DateTime  @default(now())
  usedAt    DateTime? // set when a score is accepted
  voidedAt  DateTime? // set when a newer run supersedes this one

  @@index([userId, game, createdAt])
}

model ArcadeScore {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  game      String // "hopper"
  score     Int
  runToken  String   @unique // server-issued token, one score per run
  createdAt DateTime @default(now())

  @@index([game, score])
}

// Treasury movements mirrored off-chain for the transparency dashboard.
model TreasuryEvent {
  id        String   @id @default(cuid())
  kind      String // "house_take" | "payout" | "prize" | "deposit" | "ops"
  amount    BigInt // lamports (SOL) or raw RIBBIT depending on `asset`
  asset     String   @default("RIBBIT") // "SOL" | "RIBBIT" | "CREDITS"
  note      String?
  ref       String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// One row per on-chain signature EVER redeemed for value, across every
// redemption path (credit buy, auction deposit, pure burn). This is the shared
// uniqueness guard the per-table @unique indexes can't provide: a buy tx's
// treasury-transfer leg also passes deposit verification, and the cross-table
// pre-checks are check-then-act — two CONCURRENT requests could each pass and
// commit to different tables, redeeming one payment twice. Every redemption
// transaction writes here FIRST; the second committer hits the PK conflict and
// its whole transaction rolls back.
model RedeemedSignature {
  signature String   @id
  kind      String // "buy" | "deposit" | "burn"
  createdAt DateTime @default(now())
}

// Invite codes for the invite-only launch gate. A NEW wallet can only create
// an account by presenting a live code (existing users sign in freely). Uses
// are consumed atomically (uses < maxUses guard); the gate itself is the
// live-tunable "inviteRequired" house switch.
model InviteCode {
  id        String   @id @default(cuid())
  code      String   @unique // human-shareable, stored uppercase
  maxUses   Int      @default(1)
  uses      Int      @default(0)
  note      String? // who/what this batch was for
  disabled  Boolean  @default(false)
  createdBy String? // admin wallet that minted it
  createdAt DateTime @default(now())
}

// Admin-tunable house parameters. Each row overrides the env default for one
// key (see src/lib/settings.ts for the registry, validation and caching).
// Changes are audited as TreasuryEvent kind "config".
model HouseSetting {
  key       String   @id
  value     String
  updatedBy String? // admin wallet that last changed it
  updatedAt DateTime @updatedAt
}
